# Copie para .env. Nunca versione credenciais reais.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
API_PORT=8000
# Para execução nativa, altere se necessário. No Compose, a URL é montada pelo serviço.
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# O Docker usa host.docker.internal para acessar o Ollama instalado no host.
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_API_KEY=chave-do-endpoint
# EMBEDDING_API_KEY=chave-do-endpoint
# RAG_CONFIG=config/lab.local.yaml
